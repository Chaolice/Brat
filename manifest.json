{
  "name": "Brat",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["js/content.js", "js/eat.js", "js/pet.js"],
      "css": ["html/style.css"],

      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [{
    "resources": [ "html/pet.html",
    "js/script.js",
    "css/body.css"],
    "matches": ["<all_urls>"],
    "use_dynamic_url": true
  }],
  "permissions": [ "activeTab" ]
}